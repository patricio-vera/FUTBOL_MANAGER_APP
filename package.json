{
  "name": "futbol-manager-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "lint": "next lint",
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "prisma generate && tsc --noEmit && eslint . --max-warnings=0 && vitest run"
  },
  "prisma": {
    "seed": "npm run seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^1.14.0",
    "next": "16.3.5",
    "next-auth": "^4.24.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.0.1",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
